# Event & Workshop Registration System - Environment Configuration Template
# Copy this file to .env for local customized overrides

# Application Mode & Security
APP_ENV=development
TICKET_SECRET_KEY=change-me-to-a-cryptographically-secure-random-key-in-production

# SQLite Database Location (defaults to local events_system.db)
DATABASE_FILE=events_system.db

# Optional Email / SMTP Dispatcher Settings (disabled by default)
SMTP_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@university.edu

